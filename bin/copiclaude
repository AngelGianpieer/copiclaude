#!/usr/bin/env bash
set -euo pipefail

readonly APP_NAME="copiclaude"
readonly CONFIG_DIR="${XDG_CONFIG_HOME:-"$HOME/.config"}/$APP_NAME"
readonly CONFIG_FILE="$CONFIG_DIR/config"

print_help() {
  cat <<'EOF'
CopiClaude - launcher for Claude Code and GitHub Copilot CLI

Usage:
  copiclaude                         Launch the selected assistant
  copiclaude claude                  Launch Claude Code
  copiclaude copilot                 Launch GitHub Copilot CLI
  copiclaude use <claude|copilot>    Select the default assistant
  copiclaude status                  Show the current selection and availability
  copiclaude config                  Print the config file path
  copiclaude help                    Show this help

The default selection is stored in:
  ${XDG_CONFIG_HOME:-$HOME/.config}/copiclaude/config
EOF
}

die() {
  printf 'copiclaude: %s\n' "$*" >&2
  exit 1
}

ensure_config() {
  if [[ ! -f "$CONFIG_FILE" ]]; then
    mkdir -p "$CONFIG_DIR"
    printf 'assistant=copilot\n' > "$CONFIG_FILE"
  fi
}

read_assistant() {
  ensure_config
  local assistant
  assistant="$(sed -n 's/^assistant=//p' "$CONFIG_FILE" | head -n 1)"
  case "$assistant" in
    claude|copilot) printf '%s\n' "$assistant" ;;
    '') die "invalid or empty configuration in $CONFIG_FILE" ;;
    *) die "unknown assistant '$assistant' in $CONFIG_FILE" ;;
  esac
}

command_for() {
  case "$1" in
    claude) printf '%s\n' "claude" ;;
    copilot) printf '%s\n' "copilot" ;;
    *) die "unknown assistant '$1' (use claude or copilot)" ;;
  esac
}

launch() {
  local assistant="$1"
  local command
  command="$(command_for "$assistant")"
  command -v "$command" >/dev/null 2>&1 ||
    die "'$command' was not found in PATH; install it before launching CopiClaude"
  exec "$command"
}

status() {
  local assistant
  assistant="$(read_assistant)"
  printf 'Selected assistant: %s\n' "$assistant"
  printf 'Config file: %s\n' "$CONFIG_FILE"
  for assistant in claude copilot; do
    if command -v "$assistant" >/dev/null 2>&1; then
      printf '%s: available (%s)\n' "$assistant" "$(command -v "$assistant")"
    else
      printf '%s: unavailable\n' "$assistant"
    fi
  done
}

use_assistant() {
  [[ $# -eq 1 ]] || die "usage: copiclaude use <claude|copilot>"
  case "$1" in
    claude|copilot) ;;
    *) die "assistant must be claude or copilot" ;;
  esac
  mkdir -p "$CONFIG_DIR"
  printf 'assistant=%s\n' "$1" > "$CONFIG_FILE"
  printf 'Default assistant set to %s.\n' "$1"
}

main() {
  local action="${1:-}"
  case "$action" in
    '') launch "$(read_assistant)" ;;
    claude|copilot) [[ $# -eq 1 ]] || die "direct launch accepts no extra arguments"; launch "$action" ;;
    use) shift; use_assistant "$@" ;;
    status) [[ $# -eq 1 ]] || die "status accepts no arguments"; status ;;
    config) [[ $# -eq 1 ]] || die "config accepts no arguments"; ensure_config; printf '%s\n' "$CONFIG_FILE" ;;
    help|-h|--help) [[ $# -eq 1 ]] || die "help accepts no arguments"; print_help ;;
    *) die "unknown command '$action'; run 'copiclaude help'" ;;
  esac
}

main "$@"
